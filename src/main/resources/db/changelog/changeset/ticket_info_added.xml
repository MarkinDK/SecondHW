<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="6" author="MarkinDK">
        <createTable tableName="ticket_info">
            <column name="ticket_info_id" type="uuid">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="price" type="decimal(19,2)">
                <constraints nullable="false"/>
            </column>
            <column name="currency" type="varchar(10)">
                <constraints nullable="false"/>
            </column>
            <column name="availability" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="attraction_id" type="uuid">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="ticket_info"
                baseColumnNames="attraction_id"
                referencedTableName="attractions"
                referencedColumnNames="attraction_id"
                constraintName="fk_ticket_info_attraction"/>
    </changeSet>
</databaseChangeLog>